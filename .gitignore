# Build outputs
build/
*.aar
*.tsbuildinfo

# Android
android/build/
android/.gradle/
android/local.properties

# Android test harness (the wrapper itself is committed)
tests/android/.gradle/
tests/android/build/
tests/android/local.properties

# iOS
ios/build/
ios/*.xcframework
ios/Pods/

# Swift Package Manager (the host-side test build)
.build/
.swiftpm/
Package.resolved

# Node
node_modules/

# Example app (native dirs are regenerated by `npx expo prebuild`)
example/node_modules/
example/ios/
example/android/
example/.expo/

# Working notes and scratch files kept beside the checkout, which belong to whoever wrote them
# rather than to the package
.local/

# OS
.DS_Store
Thumbs.db
