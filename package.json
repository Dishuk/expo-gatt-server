{
  "name": "expo-gatt-server",
  "version": "0.1.0",
  "description": "Expo module for BLE GATT server (peripheral) functionality",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "sideEffects": false,
  "files": [
    "build",
    "ios",
    "android/src",
    "android/build.gradle",
    "android/consumer-rules.pro",
    "expo-module.config.json",
    "app.plugin.js",
    "plugin/build"
  ],
  "scripts": {
    "build": "expo-module build",
    "build:plugin": "expo-module build plugin",
    "clean": "expo-module clean && expo-module clean plugin",
    "lint": "expo-module lint --max-warnings 0 && expo-module lint plugin --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.check.json && tsc --noEmit -p plugin/tsconfig.check.json",
    "test": "expo-module test",
    "test:ios": "swift test",
    "test:android": "./scripts/test-android.sh",
    "prepare": "node ./scripts/build-package.js",
    "prepublishOnly": "node ./scripts/build-package.js --clean"
  },
  "keywords": [
    "expo",
    "react-native",
    "bluetooth",
    "ble",
    "gatt",
    "server",
    "peripheral"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Dishuk/expo-gatt-server.git"
  },
  "author": "Dishuk",
  "homepage": "https://github.com/Dishuk/expo-gatt-server",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.1.1",
    "eslint": "^9.39.5",
    "expo": "~57.0.8",
    "jest": "^29.7.0",
    "expo-module-scripts": "^56.0.3",
    "expo-modules-core": "~57.0.7",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "typescript": "~5.9.3"
  },
  "peerDependencies": {
    "expo": ">=57.0.0",
    "expo-modules-core": "*",
    "react": "*",
    "react-native": "*"
  }
}
